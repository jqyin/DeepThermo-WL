#!/bin/bash -l
#SBATCH -A stf016
#SBATCH -J deepbench
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH --exclusive
#SBATCH -o deepbench-%j.out

# 3D convolution kernel benchmark on Frontier (AMD MI250X + MIOpen).

module load PrgEnv-gnu
module load rocm
export CPATH=$ROCM_PATH/miopen/include:$CPATH
export LIBRARY_PATH=$ROCM_PATH/miopen/lib:$LIBRARY_PATH
export CPATH=$ROCM_PATH/rocblas/include:$CPATH
export LIBRARY_PATH=$ROCM_PATH/rocblas/lib:$LIBRARY_PATH


export MIOPEN_ENABLE_LOGGING=1
export MIOPEN_ENABLE_LOGGING_CMD=1
export MIOPEN_LOG_LEVEL=6

BENCH_ROOT=./src/bin
CONV_BENCH=$BENCH_ROOT/conv_bench

# build
if [ ! -f  $CONV_BENCH ]; then
    pushd ./src
    make 
    popd
fi

HOME=/tmp srun -n 1 --gpus-per-node=1 $CONV_BENCH  > log.fp32



